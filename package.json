{
  "name": "ki00",
  "version": "0.1.0",
  "private": true,
  "description": "KI00 — a Cloudflare-native deployment platform",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev --port 8787 --ip 0.0.0.0",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "build": "npm run typecheck && npm run build:web && wrangler deploy --dry-run --outdir dist/worker",
    "build:web": "vite build",
    "deploy": "npm run build:web && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build:web",
    "secrets:check": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "hono": "^4.9.10",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^16.5.0",
    "lucide-react": "^0.545.0",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "wrangler": "^4.43.0"
  }
}
