# ── KI00 local development secrets ─────────────────────────────────────────────
# Copy to .dev.vars (git-ignored) and fill in. Never commit the real file.
#
# Cloudflare API token (user-scoped). Needed permissions:
#   Account: Workers Scripts:Edit, Workers Builds Configuration:Edit (Workers CI Write),
#            Workers KV Storage:Edit, Workers R2 Storage:Edit, D1:Edit,
#            Workers Observability:Read, Account Settings:Read
#   Zone:    Workers Routes:Edit, Zone:Read  (all zones, or restrict to your zone)
#   User:    User Details:Read, Memberships:Read
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Fine-grained GitHub PAT with Contents:Read (add Contents:Write to let the agent
# create patch branches) and Metadata:Read. Public repositories can be analysed
# without a token, but deployment setup needs the Cloudflare GitHub App anyway.
GITHUB_TOKEN=

# OpenRouter key — only ever read from this Worker secret.
OPENROUTER_API_KEY=

# 32 random bytes, base64 encoded. Generate: openssl rand -base64 32
KI00_ENCRYPTION_KEY=

# One-time token required to create the first owner account. Generate a long random value.
KI00_SETUP_TOKEN=

# Optional Workers Builds token. Prefer KI00_BUILD_TOKEN_UUID from the Cloudflare
# dashboard (Worker → Settings → Builds → API token). Alternatively provide the
# dedicated token's value and API token id so KI00 can register it:
# KI00_BUILD_TOKEN_UUID=
# KI00_BUILD_TOKEN_SECRET=
# KI00_BUILD_TOKEN_ID=
# Optional agent model override (must be a free, tool-capable model).
# KI00_AGENT_MODEL=

# Local-only demo mode. NEVER enable on a public deployment.
KI00_DEMO=1
KI00_ENV=development
